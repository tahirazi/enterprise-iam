root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
tab_width = 4
csharp_new_line_before_open_brace = all
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_preserve_single_line_blocks = false
csharp_preserve_single_line_statements = false
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning
dotnet_diagnostic.SA1200.severity = error
dotnet_diagnostic.SA1633.severity = none
dotnet_diagnostic.CS1591.severity = error
dotnet_diagnostic.SA1600.severity = error
dotnet_diagnostic.SA1601.severity = error
dotnet_diagnostic.SA1604.severity = error
dotnet_diagnostic.SA1605.severity = error
dotnet_diagnostic.SA1611.severity = error
dotnet_diagnostic.SA1614.severity = error
dotnet_diagnostic.SA1507.severity = error
dotnet_diagnostic.SA1508.severity = error
dotnet_diagnostic.SA1107.severity = error
dotnet_diagnostic.SA1116.severity = warning
dotnet_diagnostic.SA1117.severity = warning
dotnet_diagnostic.SA1518.severity = error
dotnet_diagnostic.IDE0005.severity = none

[**/Migrations/**/*.cs]
generated_code = true

# Razor Pages code-behind classes conventionally use the Model suffix.
[**/Pages/**/*.cshtml.cs]
dotnet_diagnostic.SA1649.severity = none
